{
  "name": "kleps",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @kleps/api test:integration",
    "test:e2e": "pnpm --filter @kleps/e2e test",
    "db:generate": "pnpm --filter @kleps/db generate",
    "db:migrate": "pnpm --filter @kleps/db migrate:dev",
    "db:deploy": "pnpm --filter @kleps/db migrate:deploy",
    "db:seed": "pnpm --filter @kleps/db seed",
    "db:status": "pnpm --filter @kleps/db migrate:status",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.6.2",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
