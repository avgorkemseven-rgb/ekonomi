{
  "name": "@kleps/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest --config jest.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@kleps/db": "workspace:*",
    "@kleps/shared": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.0",
    "jest": "29.7.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
