# ───────────────────────── KLEPS environment template ─────────────────────────
# Copy to .env (git-ignored). Never commit real secrets.

NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://kleps:kleps@localhost:5432/kleps?schema=public
# Separate database used by API integration tests (will be migrated + truncated by the tests)
DATABASE_URL_TEST=postgresql://kleps:kleps@localhost:5432/kleps_test?schema=public
# Empty scratch database used to generate migrations non-interactively (pnpm --filter @kleps/db migrate:create <name>)
SHADOW_DATABASE_URL=postgresql://kleps:kleps@localhost:5432/kleps_shadow?schema=public

# Redis (reserved for phase 2 jobs/queues; not required in phase 1)
REDIS_URL=redis://localhost:6379

# ── API (apps/api)
API_PORT=4000
# Public base URL of the API (used to build media URLs in local storage mode)
API_PUBLIC_URL=http://localhost:4000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Seconds during which a just-rotated refresh token can be re-presented (parallel requests) without revoking the session family
REFRESH_REUSE_GRACE_SECONDS=10
# Comma-separated browser origins allowed by CORS (mobile/BFF calls do not need CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Marketplace rules
LISTING_ACTIVE_LIMIT_INDIVIDUAL=10
LISTING_EXPIRY_DAYS=60
LISTING_MAX_PHOTOS=15
PHOTO_MAX_BYTES=15728640
VIDEO_MAX_BYTES=104857600
# risk | all | none   (none is rejected when NODE_ENV=production)
MODERATION_MODE=risk

# ── Media storage: local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.data/uploads
# S3-compatible (Cloudflare R2: endpoint https://<account>.r2.cloudflarestorage.com, region auto)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL that serves the bucket (custom domain / r2.dev)
S3_PUBLIC_BASE_URL=

# ── Seed
SEED_ADMIN_EMAIL=admin@kleps.local
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_DEMO=true

# ── Web / admin (Next.js) — server-side URL of the API
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Mobile (Expo) — must be reachable from the device (use your LAN IP for physical devices)
EXPO_PUBLIC_API_URL=http://localhost:4000
